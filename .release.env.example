# Copy this file to .release.env (git-ignored). Values use shell syntax.
# Your paid Apple Developer Program team ID. Alternatively set it in project.yml.
DEVELOPMENT_TEAM=YOURTEAMID

# Optional: defaults to the Apple ID signed into Xcode → Settings → Accounts.
# For API-key uploads, create an App Store Connect key with App Manager access
# and an Apple Distribution certificate with its private key in your keychain.
# ASC_KEY_ID=ABC123DEF4
# ASC_ISSUER_ID=12345678-aaaa-bbbb-cccc-1234567890ab
# ASC_KEY_PATH="$HOME/.appstoreconnect/private_keys/AuthKey_ABC123DEF4.p8"

# Optional: the simulator for unit and UI tests. A device name picks the newest
# installed runtime that supports it and creates the simulator if missing;
# add OS=26.5 to pin a version. Defaults to iPhone 18 Pro.
# TEST_DESTINATION='platform=iOS Simulator,name=iPhone 18 Pro'
# DEVELOPER_DIR=/Applications/Xcode.app/Contents/Developer
